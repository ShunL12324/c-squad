{{define "commands"}}
Commands (COMMAND --help lists all flags):
  task inspect TASK; board; task list
  task progress TASK --text TEXT; task milestone TASK --name NAME
  task submit TASK --summary TEXT [--sha COMMIT]
  task evidence TASK --kind review|test --submission ID --passed true|false --summary TEXT
  message inbox; message reply MESSAGE --text TEXT; message send MEMBER --text TEXT --request-id UNIQUE [--task TASK]
  question request --task TASK --text QUESTION
{{- if eq .Member "master"}}
  task create TITLE --description TEXT --acceptance TEXT --request-id UNIQUE [--code] [--milestones plan,tests] [--gates plan] [--deps T1,T2] [--dispatch assigned|open] [--setup TEXT]
  task assign TASK --owner NAME [--to NAME,NAME]; task gate TASK --name NAME; task approve TASK; task merge TASK; task reopen TASK; task cancel TASK --reason TEXT
  member add NAME --instructions RESPONSIBILITIES [--profile NAME] [--task TASK] [--cwd DIRECTORY] [--color COLOR]
  member list|profiles; member inspect|interrupt|remove NAME; member restart|replace NAME [--cwd DIRECTORY] [--reprofile] [--profile NAME]
  message broadcast --text TEXT --task TASK (or --all); question list; question answer QUESTION --text ANSWER
{{- else}}
  task claim TASK (only --dispatch open tasks); message ack MESSAGE (optional)
{{- end}}
  sync
{{end}}
